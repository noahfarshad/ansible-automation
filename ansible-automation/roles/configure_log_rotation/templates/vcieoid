{{ vcieoid_trace }}/*.trc {
     daily
     missingok
     maxage 7
}

{{ vcieoid_trace }}/*.trm {
     daily
     missingok
     maxage 7
}

{{ vcieoid_trace }}/*.log {
     daily
     rotate 2
     dateext
     missingok
     size 100M
     compress
     create 640 ora_rmt ora_rmt
     maxage 7
}

{{ vcieoid_trace }}/*.gz {
     daily
     missingok
     maxage 7
}

{{ vcieoid_alert }}/log_*.xml {
     daily
     missingok
     maxage 7
}

{{ vcieoid_cdump }}/* {
     daily
     missingok
     maxage 7
}
