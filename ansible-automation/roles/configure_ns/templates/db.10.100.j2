$TTL    604800
@       IN      SOA     string.local. admin.string.local. (
                              3         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
; name servers
            IN      NS      ns01.string.local.

; PTR Records
