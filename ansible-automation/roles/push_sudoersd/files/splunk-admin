# This sudo config file allows users to perform commands as splunk

# User Aliases
User_Alias      SEMS_SPLUNKADMIN =       +fn_splunk-client



# These define the possible application accounts (comma-separated)
Runas_Alias 	SPLUNK_APPACCT = 		splunk

# These define the possible hosts that users are allowed to run commands on

# This controls who can do what now  (the ALL refers to ALL hosts, that is, localhost in this context)
# Note: use of sudo is logged in via syslog to /var/log/secure. 
# 	If the LOG_INPUT: and LOG_OUTPUT: directives are defined below, then you can also use the sudoreplay command
# 	to see the input/output of every command as it was being executed.

# Allow SplunkAdmins netgroup to sudo to splunk account
# Since this file is deployed to both RHEL5 and RHEL6 hosts, we can't log input/output since RHEL5 can't support it
#  Once all RHEL5 hosts are gone, we could set it back to logging input/output
#SEMS_SPLUNKADMIN		ALL = (SPLUNK_APPACCT) LOG_OUTPUT: LOG_INPUT: NOPASSWD: ALL
SEMS_SPLUNKADMIN		ALL = (SPLUNK_APPACCT) ALL

