# Don't use sudo aliases - it messes up the Ansible validation command and is largely unneeded with Ansible doing the sudo management
#  Just list the required sudo command
#
# Allow the un-sems-afwwebs and un-tads-afwwebs netgroups access to manage the JBoss webserver

+un_sems-afwwebs  ALL=(afwadmin) NOPASSWD: LOG_OUTPUT: LOG_INPUT: ALL
+un_sems-afwwebs  ALL=(root) /bin/systemctl start jws5-tomcat
+un_sems-afwwebs  ALL=(root) /bin/systemctl status jws5-tomcat
+un_sems-afwwebs  ALL=(root) /bin/systemctl stop jws5-tomcat
+un_sems-afwwebs  ALL=(root) /bin/systemctl restart jws5-tomcat
+un_sems-afwwebs  ALL=(root) /bin/journalctl -u jws5-tomcat

+un_tads-afwwebs  ALL=(afwadmin) NOPASSWD: LOG_OUTPUT: LOG_INPUT: ALL
+un_tads-afwwebs  ALL=(root) /bin/systemctl start jws5-tomcat
+un_tads-afwwebs  ALL=(root) /bin/systemctl status jws5-tomcat
+un_tads-afwwebs  ALL=(root) /bin/systemctl stop jws5-tomcat
+un_tads-afwwebs  ALL=(root) /bin/systemctl restart jws5-tomcat
+un_tads-afwwebs  ALL=(root) /bin/journalctl -u jws5-tomcat

+fn_afwWebMisc,!+un_sems-testers,!+un_tads-testers  ALL = (afwadmin) NOPASSWD: LOG_OUTPUT: LOG_INPUT: ALL
