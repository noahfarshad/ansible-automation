#
# Don't use sudo aliases - it messes up the Ansible validation command and is largely unneeded with Ansible doing the sudo management
#  Just list the required sudo command
#
#

+un_sems-afwwebs  ALL=(afwadmin) NOPASSWD: LOG_OUTPUT: LOG_INPUT: ALL
+un_sems-afwwebs  ALL=(root) /usr/bin/systemctl restart jws5-tomcat, /usr/bin/systemctl start jws5-tomcat, /usr/bin/systemctl stop jws5-tomcat, /usr/bin/systemctl status jws5-tomcat, /bin/journalctl -u jws5-tomcat

+un_tads-afwwebs  ALL=(afwadmin) NOPASSWD: LOG_OUTPUT: LOG_INPUT: ALL
+un_tads-afwwebs  ALL=(root) /usr/bin/systemctl restart jws5-tomcat, /usr/bin/systemctl start jws5-tomcat, /usr/bin/systemctl stop jws5-tomcat, /usr/bin/systemctl status jws5-tomcat, /bin/journalctl -u jws5-tomcat
+fn_afwWebMisc,!+un_sems-testers,!+un_tads-testers  ALL = (afwadmin) NOPASSWD: LOG_OUTPUT: LOG_INPUT: ALL
