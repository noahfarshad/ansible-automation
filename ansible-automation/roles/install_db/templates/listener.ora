# listener.ora Network Configuration File: /opt/oracle/app/ora_rmt/product/11.2.0.2i/network/admin/listener.ora
# Generated by Oracle configuration tools.

{{listener_name}} =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ansible_fqdn}})(PORT = {{listener_port}}))
    )
  )

ADR_BASE_{{listener_name}} = {{listener_adr_base}}

# Oracle DB STIG, DG0052 - DBMS software access audit
LOGGING_{{listener_name}} = on

# Oracle DB STIG, DO00286 - Oracle Connection timeout parameter
SQLNET.INBOUND_CONNECT_TIMEOUT_{{listener_name}} = {{sqlnet_inbound_connect_listener_name_timeout}}

# Oracle DB STIG, DO6740 - Oracle listener ADMIN_RESTRICTIONS parameter
ADMIN_RESTRICTIONS_{{listener_name}} = on

#Log Directory
LOG_DIRECTORY_{{listener_name}}={{listener_log_directory}}
