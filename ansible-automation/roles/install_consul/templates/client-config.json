{
  "bind_addr": "{{ ansible_default_ipv4.address }}",
  "datacenter": "{{system}}",
  "data_dir": "{{ consul_data_dir }}",
  "log_level": "INFO",
  "node_name": "{{ inventory_hostname }}Client",
  "server": false,
  "rejoin_after_leave": true,
  "retry_interval": "30s",
  "retry_join": [
    {% for hostname in hostvars[inventory_hostname].groups['consul_servers'] %}
    "{{hostvars[hostname]['ansible_default_ipv4']['address']}}"{{ "," if not loop.last else ''}}
    {% endfor %}
  ],
  "recursors": [
    {% for ip in hostvars[inventory_hostname].groups['consul_recursor_nameservers'] %}
    "{{ip}}"{{ "," if not loop.last else ''}}
    {% endfor %}
  ],
  "client_addr": "{{ ansible_default_ipv4.address }}",
  "disable_update_check": true
}