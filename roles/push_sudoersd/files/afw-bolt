# This sudo config file allows users to perform commands as Bolt 

# User Aliases
User_Alias	BOLT_APPADMIN =	+un_sems-cm,+un_sems-afwwebs,+un_sems-wdd,+un_tads-cm,+un_tads-afwwebs,+un_tads-wdd

# These are the allowed commands, referenced later
# Cmnd_Alias    SOME_CMD                /bin/bash,/bin/cat

# These define the possible application accounts (comma-separated)
Runas_Alias	BOLT_APPACCT =		bolt

# These define the possible hosts that users are allowed to run commands on
# These are defined already in the afw-j2eeadmin sudoers file
# Host_Alias	VIRAPP_PROD =		afw-virapp-01p,afw-virapp-02p
# Host_Alias	VIRAPP_TEST =		afw-virapp-01t,afw-virapp-02t
# Host_Alias	VIRAPP_DEV =		afw-virapp-01d,afw-virapp-02d
# Host_Alias	AFW_MW_PROD =		afw-mw-01p,afw-mw-02p,afw-mw-03p,afw-mw-04p,afw-mw-05p
Host_Alias	AFW_MW_TEST =		afw-mw-01t,afw-mw-02t,afw-mw-03t,afw-mw-04t,afw-mw-05t
Host_Alias	AFW_MW_DEV =		afw-mw-01d,afw-mw-02d,afw-mw-03d,afw-mw-04d,afw-mw-05d


# This controls who can do what now  (the ALL refers to ALL hosts, that is, localhost in this context)
# Note: use of sudo is logged in via syslog to /var/log/secure.
#       If the LOG_INPUT: and LOG_OUTPUT: directives are defined below, then you can also use the sudoreplay command
#       to see the input/output of every command as it was being executed.

# Group specific bolt permissions
BOLT_APPADMIN	AFW_MW_TEST,AFW_MW_DEV = (BOLT_APPACCT) LOG_OUTPUT: LOG_INPUT: ALL
